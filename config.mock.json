{
  "onebot": {
    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": ""
  },
  "llm": {
    "provider": "mock",
    "baseUrl": "https://api.deepseek.com",
    "apiKey": "",
    "model": "deepseek-flash",
    "temperature": 0.9,
    "maxTokens": 420,
    "vision": true,
    "extraBody": {
      "thinking": {
        "type": "disabled"
      }
    },
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "search": {
      "enabled": true,
      "maxRounds": 2,
      "maxSearches": 1,
      "count": 5,
      "needContent": false,
      "charLimit": 2600
    },
    "imageTimeoutMs": 10000
  },
  "bot": {
    "nick": "助手",
    "aliases": [],
    "defaultPersonaId": "whalegirl"
  },
  "personaFile": "./persona.md",
  "mode": "auto",
  "groups": [
    {
      "id": 123456789,
      "name": "测试群（mock）",
      "enable": true,
      "proactive": true
    }
  ],
  "rules": {
    "minIntervalMs": 2000,
    "perGroupCooldownMs": 4000,
    "maxPerHour": 20,
    "dailyCap": 150,
    "quietHours": [
      "00:00",
      "07:30"
    ],
    "maxReplyChars": 220,
    "replyWithAt": true
  },
  "proactive": {
    "enabled": true,
    "keywords": [
      "有人吗",
      "在干嘛",
      "好无聊"
    ],
    "maxPerHour": 5
  },
  "awareness": {
    "_说明": "话题嗅觉：①冷场时主动开话题 ②别人聊天时伺机插话",
    "enabled": true,
    "windowMinutes": 60,
    "revive": {
      "enabled": true,
      "silenceMinutes": 25,
      "minRecentMessages": 8,
      "cooldownMinutes": 120,
      "maxPerDay": 2
    },
    "join": {
      "enabled": true,
      "requireConversation": true,
      "probability": 0.25,
      "minSilenceSinceBot": 10,
      "cooldownMinutes": 15,
      "maxPerHour": 3,
      "maxPerDay": 10
    },
    "activeMinutes": 5
  },
  "history": {
    "size": 16
  },
  "safety": {
    "blockedWords": [
      "傻逼",
      "去死",
      "滚开"
    ]
  },
  "autoAcceptNewGroups": true,
  "blockedGroups": [],
