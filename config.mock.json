  "intent": {
    "enabled": true,
    "threshold": 10,
    "_说明": "语义触发阈值：分数≥阈值就回；人格文件里的 replyRate 优先",
    "imageCooldownMs": 20000,
    "imageDedupMs": 90000,
    "batchSize": 20
