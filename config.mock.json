    "proactive": false
  },
  "server": {
    "enable": true,
    "host": "127.0.0.1",
    "port": 8123,
    "token": ""
  },
  "easter": {
    "enabled": true,
    "durationMs": 3600000,
    "returnLine": [
      "诶？我刚才是不是不在状态……算了。总之我在啦，有事说事。",
      "唔……刚走神了。刚才谁在叫我？",
      "啊，我回来了。有什么热闹可以看吗？"
    ],
    "cooldownMs": 60000,
    "resetCooldownMs": 10000,
    "maxPerHour": 3
  },
